# URL base de la API del backend, incluyendo el prefijo /api.
# En desarrollo local: http://localhost:4000/api
# En produccion (Render): https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# Habilita la interfaz de IA de EA3. La clave se configura solo en el backend.
VITE_IA_HABILITADA=true
