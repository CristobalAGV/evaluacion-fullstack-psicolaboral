PORT=4000
MONGO_URI=mongodb://localhost:27017/evaluacion-psicolaboral
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=1d
# Uno o varios origenes permitidos por CORS, separados por coma.
# Ejemplo en produccion: http://localhost:5173,https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Clave de la API de Google Gemini, usada por la integracion de IA
# (rama feature/integracion-ia). Se obtiene en https://aistudio.google.com/apikey
# Nunca subas la clave real al repositorio.
GEMINI_API_KEY=tu_clave_de_gemini_aqui
