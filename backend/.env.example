PORT=4000
MONGO_URI=mongodb://localhost:27017/evaluacion-psicolaboral
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=1d
# Uno o varios origenes permitidos por CORS, separados por coma.
# Ejemplo en produccion: http://localhost:5173,https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Clave de la API de Google Gemini, usada por la integracion de IA
# (rama feature/integracion-ia). Se obtiene en https://aistudio.google.com/apikey
# Nunca subas la clave real al repositorio.
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo de Gemini a usar (opcional). Por defecto: gemini-3.8-flash
# Otros modelos Flash disponibles: gemini-3.5-flash, gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# Modelo de respaldo (opcional). Si el modelo principal responde 503 (alta demanda)
# despues de los reintentos, se prueba una vez con este. Sin definir: no hay respaldo.
# GEMINI_MODEL_RESPALDO=gemini-3.6-flash

# Nivel de razonamiento ("thinking") del modelo (opcional): minimal, low, medium o high.
# Por defecto low (el mas bajo que acepta gemini-3.8-flash; minimal da error en ese modelo).
# Vacia: no se envia y el modelo usa su nivel por defecto (medium).
# GEMINI_NIVEL_RAZONAMIENTO=low

# Esperas (ms) antes de cada reintento ante un 503, separadas por coma (opcional).
# Por defecto 2000,5000. Vacia desactiva los reintentos. Solo se reintenta el 503.
# GEMINI_ESPERAS_REINTENTO_MS=2000,5000
